# ==============================================================================
# AI Code Review Agent - LLM Configuration Options
# Choose ANY of the following options (Option 1 requires NO keys & NO payment!)
# ==============================================================================

# ------------------------------------------------------------------------------
# OPTION 1: Zero Key / Smart Offline Local Mode (DEFAULT - 100% FREE)
# Leave all API keys blank or commented out. The backend will automatically run
# local rule-based static analysis heuristics without needing any Azure or OpenAI account.
# ------------------------------------------------------------------------------

# ------------------------------------------------------------------------------
# OPTION 2: Free Groq Cloud Key (100% FREE - High Speed Llama 3.3 / Qwen)
# Get a free key at: https://console.groq.com/keys
# ------------------------------------------------------------------------------
# GROQ_API_KEY=gsk_your_groq_api_key_here
# GROQ_MODEL=llama-3.3-70b-versatile

# ------------------------------------------------------------------------------
# OPTION 3: Free Local Ollama Model (100% FREE & OFFLINE)
# Download Ollama at: https://ollama.com
# Run in terminal: ollama run qwen2.5-coder
# ------------------------------------------------------------------------------
# USE_OLLAMA=true
# OLLAMA_MODEL=qwen2.5-coder

# ------------------------------------------------------------------------------
# OPTION 4: Standard OpenAI API Key
# ------------------------------------------------------------------------------
# OPENAI_API_KEY=sk-your_openai_api_key_here
# OPENAI_MODEL=gpt-4o-mini

# ------------------------------------------------------------------------------
# OPTION 5: Azure OpenAI (Optional)
# ------------------------------------------------------------------------------
# AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
# AZURE_OPENAI_API_KEY=your_azure_key_here
# AZURE_OPENAI_API_VERSION=2024-08-preview
# AZURE_OPENAI_DEPLOYMENT_NAME=gpt-4o
